# --- Required ---

# RTSP/HTTP/file URL of the video stream to describe (any ffmpeg-readable input).
STREAM_URL=rtsp://camera.local/stream1

# --- Vision backend ---

# One of: ollama | seedeer
VISION_BACKEND=ollama

# --- Ollama connection (used when VISION_BACKEND=ollama) ---

# Base URL of the Ollama instance. Use the service name when running via
# docker-compose on the same network (e.g. http://ollama:11434).
OLLAMA_URL=http://ollama:11434

# Vision-capable model to use for inference.
OLLAMA_MODEL=qwen3-vl:8b

# --- seedeer (used when VISION_BACKEND=seedeer) ---

# Hugging Face model id for seedeer's local VQA backend.
SEEDEER_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct

# Worker pool mode: process | thread | socket | grpc
SEEDEER_MODE=process

# Inference device: cpu | gpu | auto
SEEDEER_DEVICE=auto

# --- Prompting ---

# Path to the system prompt file defining the JSON schema and scene context.
SYSTEM_PROMPT_FILE=./system-prompt.md

# --- Trigger mode ---

# One of: fps | motion | both
TRIGGER_MODE=fps

# Seconds between frame captures in fps mode (and the cadence ceiling in both mode).
FRAME_INTERVAL=2

# Minimum seconds between frames in motion mode (also the dedupe window in both mode).
MIN_FRAME_INTERVAL=1

# ffmpeg scene-change sensitivity (0-1). Lower = more sensitive.
SCENE_CHANGE_THRESHOLD=0.3

# --- Frame capture ---

FRAME_WIDTH=320
FRAME_HEIGHT=180

# --- State history ---

# Number of past JSON states kept in memory and sent as context to each inference call.
HISTORY_DEPTH=10

# Number of past frame images kept and sent as additional visual context (0 disables).
HISTORY_IMAGES=0

# --- Webhook (optional) ---

# If unset, the webhook is disabled entirely.
WEBHOOK_URL=

# One of: always | on_change
WEBHOOK_MODE=on_change

# Optional bearer token sent as `Authorization: Bearer <token>`.
WEBHOOK_TOKEN=

# --- MCP server ---

MCP_PORT=3100

# --- Resilience ---

# Max ffmpeg reconnect attempts before giving up (0 = unlimited).
STREAM_RECONNECT_MAX=0
